/* Cloudflare Workers: 静的アセット + マルチプレイ部屋 + 山の記録 */
{
  "name": "tozanbu",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/ws", "/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "MountainRoom" },
      { "name": "REGISTRY", "class_name": "MountainRegistry" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MountainRoom", "MountainRegistry"] }],
  "observability": { "enabled": true }
}
